+    uint8_t btMac[6];
+    ESP_ERROR_CHECK(esp_efuse_mac_get_default(btMac));
+    ESP_ERROR_CHECK(migrateDualMeshLocalIrk(btMac));
+    ESP_ERROR_CHECK(esp_iface_mac_addr_set(btMac, ESP_MAC_BT));
+#endif
