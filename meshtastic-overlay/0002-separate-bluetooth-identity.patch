+#if defined(ARCH_ESP32) && defined(DUALMESH)
+// NimBLE stores one local IRK, keyed by controller public address. Re-key it
+// before host init so changing the address does not regenerate it every boot.
+static esp_err_t migrateDualMeshLocalIrk(const uint8_t *btMac)
+{
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open("nimble_bond", NVS_READWRITE, &handle);
+    if (err == ESP_ERR_NVS_NOT_FOUND) {
+        return ESP_OK;
+    }
+    if (err != ESP_OK) {
+        return err;
+    }
+
+    struct ble_store_value_local_irk record;
+    size_t size = sizeof(record);
+    err = nvs_get_blob(handle, "local_irk_1", &record, &size);
+    if (err == ESP_OK) {
+        if (size != sizeof(record)) {
+            err = ESP_ERR_NVS_INVALID_LENGTH;
+        } else {
+            ble_addr_t identity = {};
+            identity.type = BLE_ADDR_PUBLIC;
+            for (size_t i = 0; i < sizeof(identity.val); ++i) {
+                identity.val[i] = btMac[5 - i]; // NimBLE uses little-endian addresses.
+            }
+            if (record.addr.type != identity.type || memcmp(record.addr.val, identity.val, sizeof(identity.val)) != 0) {
+                record.addr = identity;
+                err = nvs_set_blob(handle, "local_irk_1", &record, sizeof(record));
+                if (err == ESP_OK) {
+                    err = nvs_commit(handle);
+                }
+            }
+        }
+    } else if (err == ESP_ERR_NVS_NOT_FOUND) {
+        err = ESP_OK;
+    }
+    nvs_close(handle);
+    return err;
+}
+#endif
+
